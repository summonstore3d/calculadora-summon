# Vercel: banco libSQL/Turso permanente e compartilhado entre dispositivos.
# Cadastre as duas variáveis nos ambientes Production e Preview da Vercel.
TURSO_DATABASE_URL=libsql://seu-banco-sua-organizacao.turso.io
TURSO_AUTH_TOKEN=

# Vercel: senha de acesso ao sistema. Sem ela, ninguém entra.
APP_PASSWORD=
# Opcional: chave para assinar a sessão. Se vazia, a senha é usada,
# e trocar a senha encerra todas as sessões abertas.
APP_SESSION_SECRET=
