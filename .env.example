# Copie para .env.local (no seu computador) e cadastre os mesmos nomes na Vercel
# em Settings → Environment Variables (Production e Preview).

# Senha de acesso ao sistema. Sem ela, ninguém entra.
APP_PASSWORD=

# Opcional: chave longa e aleatória para assinar a sessão. Se vazia, a senha é usada,
# e trocar a senha desconecta todo mundo.
APP_SESSION_SECRET=

# Banco Turso (libSQL), onde os dados ficam guardados. Sem estas duas, os dados
# ficam só no navegador de quem usa.
TURSO_DATABASE_URL=libsql://seu-banco-sua-organizacao.turso.io
TURSO_AUTH_TOKEN=

# Opcional: chave para a cópia semanal automática (.github/workflows/backup.yml) baixar o backup.
# Use um texto aleatório de pelo menos 24 caracteres e cadastre o mesmo valor nos segredos do GitHub.
BACKUP_SECRET=
